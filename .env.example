# Supabase project URL and publishable key are public client configuration.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Configure these as Edge Function secrets, not in this file:
# GYM_PIN=your-shared-passcode
# GYM_TOKEN_SECRET=a-long-random-secret-at-least-32-characters